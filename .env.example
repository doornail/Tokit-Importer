# Anthropic API Key (required)
ANTHROPIC_API_KEY=sk-ant-xxxxx

# NYTimes Cooking credentials (optional - for premium/authenticated recipes)
NYTIMES_EMAIL=your_email@example.com
NYTIMES_PASSWORD=your_password

# Cooknjoy credentials (required for upload)
COOKNJOY_EMAIL=your_email@example.com
COOKNJOY_PASSWORD=your_password
COOKNJOY_URL=https://cooknjoy.com

# Optional: Claude model to use (opus-4-5 recommended for best recipe conversion)
CLAUDE_MODEL=claude-opus-4-5-20251101

# Optional: Debug mode
DEBUG=false
